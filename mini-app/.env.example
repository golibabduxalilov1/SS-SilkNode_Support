# Lokal ishlab chiqish uchun localhost mumkin, LEKIN production build'da
# bu manzil HAM public HTTPS domenga ishora qilishi SHART — Telegram
# Mini App (webview) foydalanuvchi telefonida ochiladi va localhost'ga
# umuman ulana olmaydi. Backend HTTPS orqali ochiq bo'lmasa, so'rovlar
# muvaffaqiyatsiz tugaydi va webview "crash" holatiga o'xshab ko'rinadi.
# Production namunasi: https://api.sizning-domeningiz.uz/api/v1
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Botning @username'i (BotFather'dan), "@" belgisisiz. "Botga qaytish"
# tugmasi https://t.me/<shu qiymat> havolasini quradi.
VITE_BOT_USERNAME=your_bot_username
