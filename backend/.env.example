# Server
PORT=3000
# development | production — production'da barcha majburiy o'zgaruvchilar
# (pastga qarang) bootstrap paytida qat'iy tekshiriladi va noto'g'ri/
# placeholder qiymat bo'lsa ilova ishga tushmaydi (fail-fast).
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=silknode
DB_PASSWORD=silknode
DB_DATABASE=silknode_support

# Telegram Bot
# BotFather'dan olingan haqiqiy token bilan almashtiring.
BOT_TOKEN=000000000:REPLACE_WITH_BOTFATHER_TOKEN

# MUHIM: bu qiymat HTTPS bo'lishi SHART va haqiqiy, tashqi dunyodan
# ochiladigan domenga ishora qilishi kerak (masalan
# https://app.sizning-domeningiz.uz). Telegram Mini App tugmasi HTTP
# yoki localhost manzilni QABUL QILMAYDI — noto'g'ri sozlansa
# foydalanuvchida "Webview crashed" xatosi chiqadi. Localhost'da lokal
# ishlab chiqish uchun ngrok/cloudflared kabi HTTPS tunnel ishlating.
MINI_APP_URL=https://your-mini-app-domain.example.com

# Admin Panel auth (JWT)
# Xavfsiz, tasodifiy va uzun qiymat bilan almashtiring, masalan:
#   openssl rand -hex 32
# Standart/taxmin qilinadigan qiymat bilan production'ga chiqarmang.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# Bootstrap superadmin (used by seed script only)
SUPERADMIN_TELEGRAM_ID=
SUPERADMIN_LOGIN=superadmin
SUPERADMIN_PASSWORD=change_me_now
